{
  "name": "opencode-cloud",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {}
  },
  "hostRequirements": {
    "cpus": 2
  },
  "secrets": {
    "OPENCODE_PASSWORD": {
      "description": "Пароль веб-інтерфейсу OpenCode. Логін завжди opencode. Скрипт копіює цей секрет у OPENCODE_SERVER_PASSWORD (V1).",
      "documentationUrl": "https://github.com/vak0754-cell/opencode-cloud-memory/blob/main/README.md"
    },
    "DEEPSEEK_API_KEY": {
      "description": "Обов’язковий ключ DeepSeek для моделі за замовчуванням.",
      "documentationUrl": "https://github.com/vak0754-cell/opencode-cloud-memory/blob/main/README.md"
    },
    "OPENROUTER_API_KEY": {
      "description": "Необов’язково. Безкоштовні моделі OpenRouter з opencode.jsonc.",
      "documentationUrl": "https://github.com/vak0754-cell/opencode-cloud-memory/blob/main/README.md"
    },
    "GEMINI_API_KEY": {
      "description": "Необов’язково. Ключ Gemini, якщо підключите цей провайдер.",
      "documentationUrl": "https://github.com/vak0754-cell/opencode-cloud-memory/blob/main/README.md"
    },
    "GROQ_API_KEY": {
      "description": "Необов’язково. Ключ Groq, якщо підключите цей провайдер.",
      "documentationUrl": "https://github.com/vak0754-cell/opencode-cloud-memory/blob/main/README.md"
    }
  },
  "remoteEnv": {
    "PATH": "${containerEnv:HOME}/.opencode/bin:${containerEnv:PATH}",
    "OPENCODE_SERVER_USERNAME": "opencode",
    "OPENCODE_SERVER_PASSWORD": "${localEnv:OPENCODE_PASSWORD}"
  },
  "postCreateCommand": "bash .devcontainer/install-opencode.sh",
  "postStartCommand": "bash .devcontainer/start-opencode.sh",
  "forwardPorts": [4096],
  "portsAttributes": {
    "4096": {
      "label": "OpenCode web",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  }
}
